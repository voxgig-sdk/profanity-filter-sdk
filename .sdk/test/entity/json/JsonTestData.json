            "name": "fill_text",
            "required": false,
            "schema": {
              "maxLength": 20,
              "type": "string"
            }
          },
          {
            "description": "Single character used to replace any words matching the profanity list. Fills designated character to length of word replaced. Accepts underscore (_) tilde (~), dash/hyphen (-), equal sign (=), pipe (|) and asterisk (*). When not used, the default is an asterisk (*) fill.",
            "in": "query",
            "name": "fill_char",
            "required": false,
            "schema": {
              "enum": [
                "_",
                "~",
                "-",
                "=",
                "|",
                "*"
              ],
              "maxLength": 1,
              "type": "string"
            }
          }
        ],
        "protocol": "http",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "cleanText": {
                    "value": {
                      "result": "this is some test input"
                    }
                  },
                  "filteredText": {
                    "value": {
                      "result": "this is some test *****"
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "result": {
                      "description": "The filtered text with profanity removed or replaced",
                      "type": "string"
