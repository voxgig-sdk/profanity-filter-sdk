        "responses": {
          "200": {
            "description": "Successful response with filtered text",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "The filtered text with profanity removed or replaced"
                },
                "examples": {
                  "cleanText": {
                    "value": "this is some test input"
                  },
                  "filteredText": {
                    "value": "this is some test *****"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "text/plain": {
