          contract: {
            id: "GET /service/xml"
            json: "{\"operationId\":\"filterProfanityXml\",\"parameters\":[{\"description\":\"Input text to be processed\",\"in\":\"query\",\"name\":\"text\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"A comma separated list of words to be added to the profanity list. Accepts up to 10 words (or 200 maximum characters in length).\",\"in\":\"query\",\"name\":\"add\",\"required\":false,\"schema\":{\"maxLength\":200,\"type\":\"string\"}},{\"description\":\"Text used to replace any words matching the profanity list. Maximum length of 20 characters. When not used, the default is an asterisk (*) fill.\",\"in\":\"query\",\"name\":\"fill_text\",\"required\":false,\"schema\":{\"maxLength\":20,\"type\":\"string\"}},{\"description\":\"Single character used to replace any words matching the profanity list. Fills designated character to length of word replaced. Accepts underscore (_) tilde (~), dash/hyphen (-), equal sign (=), pipe (|) and asterisk (*). When not used, the default is an asterisk (*) fill.\",\"in\":\"query\",\"name\":\"fill_char\",\"required\":false,\"schema\":{\"enum\":[\"_\",\"~\",\"-\",\"=\",\"|\",\"*\"],\"maxLength\":1,\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/xml\":{\"examples\":{\"cleanText\":{\"value\":\"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\" standalone=\\\"yes\\\"?><PurgoMalum xmlns=\\\"http://www.purgomalum.com\\\"><result>this is some test input</result></PurgoMalum>\"}},\"schema\":{\"properties\":{\"result\":{\"description\":\"The filtered text with profanity removed or replaced\",\"type\":\"string\"}},\"type\":\"object\",\"xml\":{\"name\":\"PurgoMalum\",\"namespace\":\"http://www.purgomalum.com\"}}}},\"description\":\"Successful response with filtered text\"},\"400\":{\"content\":{\"application/xml\":{\"examples\":{\"fillTextTooLong\":{\"value\":\"<PurgoMalum xmlns=\\\"http://www.purgomalum.com\\\"><error>User Replacement Text Exceeds Limit of 20 Characters.</error></PurgoMalum>\"}},\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message describing the issue\",\"type\":\"string\"}},\"type\":\"object\",\"xml\":{\"name\":\"PurgoMalum\",\"namespace\":\"http://www.purgomalum.com\"}}}},\"description\":\"Bad request - invalid parameters\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
